{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "branch-schematic",
  "version": "0.1.0",
  "identifier": "com.justi.branch-schematic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Branch Schematic",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MDk0M0RCMDNDOTg4RjIKUldUeWlNa0QyME1KaDFzYkNUazV0VXYvTVlFN2VQS1JoN3orNVRqVUZyOXZaQUVNeU5jZW9TWEoK",
      "endpoints": [
        "https://github.com/ChefMooon/branch-schematic/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
